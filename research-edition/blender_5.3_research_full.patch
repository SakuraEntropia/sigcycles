+/* SPDX-FileCopyrightText: 2005 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "node_shader_util.hh"
+
+namespace blender {
+
+namespace nodes::node_shader_wave_diffraction_cc {
+
+static void node_declare(NodeDeclarationBuilder &b)
+{
+  b.add_input<decl::Color>("Color"_ustr).default_value({1.0f, 1.0f, 1.0f, 1.0f});
+  b.add_input<decl::Float>("Width"_ustr)
+      .default_value(0.0002f)
+      .min(0.0f)
+      .subtype(PROP_NONE)
+      .description("Slit width in metres");
+  b.add_input<decl::Float>("Height"_ustr).default_value(0.001f).min(0.0f);
+  b.add_input<decl::Float>("Wavelength"_ustr)
+      .default_value(550.0f)
+      .min(1.0f)
+      .max(2000.0f)
+      .subtype(PROP_WAVELENGTH)
+      .description("Wavelength in nanometres");
+  b.add_input<decl::Float>("Dispersion"_ustr)
+      .default_value(0.0f)
+      .min(0.0f)
+      .max(1.0f)
+      .subtype(PROP_FACTOR);
+  b.add_input<decl::Float>("Polarizer Angle"_ustr)
+      .default_value(0.0f)
+      .min(-1.0f)
+      .max(3.14f)
+      .description("Polarizer rotation in radians (-1 disables)");
+  b.add_input<decl::Float>("Polarized Input"_ustr).default_value(0.0f).min(0.0f).max(1.0f);
+  b.add_input<decl::Float>("Slit Separation"_ustr)
+      .default_value(0.0f)
+      .min(0.0f)
+      .description("Double-slit centre separation in metres (0 = single slit)");
+  b.add_input<decl::Vector>("Tangent"_ustr);
+  b.add_input<decl::Vector>("Normal"_ustr).hide_value();
+  b.add_output<decl::Shader>("BSDF"_ustr);
+}
+
+static void node_shader_init_wave_diffraction(bNodeTree * /*ntree*/, bNode * /*node*/)
+{
+}
+
+static int node_shader_gpu_bsdf_wave_diffraction(GPUMaterial * /*mat*/,
+                                                 bNode * /*node*/,
+                                                 bNodeExecData * /*execdata*/,
+                                                 GPUNodeStack * /*in*/,
+                                                 GPUNodeStack * /*out*/)
+{
+  return 0;
+}
+
+}  // namespace nodes::node_shader_wave_diffraction_cc
+
+void register_node_type_sh_wave_diffraction()
+{
+  namespace file_ns = nodes::node_shader_wave_diffraction_cc;
+
+  static bke::bNodeType ntype;
+
+  sh_node_type_base(&ntype, "ShaderNodeWaveDiffraction"_ustr, SH_NODE_BSDF_WAVE_DIFFRACTION);
+  ntype.ui_name = "Wave Diffraction";
+  ntype.ui_description = "Fraunhofer free-space diffraction of a slit aperture";
+  ntype.enum_name_legacy = "BSDF_WAVE_DIFFRACTION";
+  ntype.nclass = NODE_CLASS_SHADER;
+  ntype.add_ui_poll = object_shader_nodes_poll;
+  ntype.declare = file_ns::node_declare;
+  ntype.initfunc = file_ns::node_shader_init_wave_diffraction;
+  ntype.gpu_fn = file_ns::node_shader_gpu_bsdf_wave_diffraction;
+
+  bke::node_register_type(ntype);
+}
+
+}  // namespace blender
