diff --git a/intern/cycles/kernel/sample/mis.h b/intern/cycles/kernel/sample/mis.h
index eb48036221f..b726221964b 100644
--- a/intern/cycles/kernel/sample/mis.h
+++ b/intern/cycles/kernel/sample/mis.h
@@ -28,6 +28,19 @@ ccl_device float power_heuristic(const float a, const float b)
